diff --git a/buggy.py b/buggy.py
index 03a878f3af45dd471144b5edb3f8aa07c240a277..952cd90fe26e220b15b294541648a6a1f070162d
--- a/buggy.py
+++ b/buggy.py
@@ -1,4 +1,12 @@
 def min_coins(amount, coins):
-    if amount == 0:
-        return 0
-    return min(1 + min_coins(amount - coin, coins) for coin in coins if coin < amount)
+    if amount < 0:
+        return -1
+
+    dp = [0] + [amount + 1] * amount
+    for value in range(1, amount + 1):
+        dp[value] = min(
+            (dp[value - coin] + 1 for coin in coins if 0 < coin <= value),
+            default=amount + 1,
+        )
+
+    return dp[amount] if dp[amount] <= amount else -1

