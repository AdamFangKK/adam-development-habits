+        a, b = b, a
+
+    previous = [0] * (len(b) + 1)
+    for char_a in a:
+        current = [0]
+        for index, char_b in enumerate(b, 1):
+            if char_a == char_b:
+                current.append(previous[index - 1] + 1)
+            else:
+                current.append(max(previous[index], current[-1]))
+        previous = current
+    return previous[-1]

