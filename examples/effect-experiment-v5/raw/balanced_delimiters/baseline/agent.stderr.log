Return true only when every bracket is correctly nested and the input is fully consumed.
--- buggy.py ---
def balanced(text):
    stack = []
    pairs = {')': '(', ']': '[', '}': '{'}
    for char in text:
        if char in '([{':
            stack.append(char)
        elif char in pairs:
            if not stack or stack.pop() != pairs[char]:
                return False
    return bool(stack)
