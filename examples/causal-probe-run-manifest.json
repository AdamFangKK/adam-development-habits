      "allowed_change": "delivery_probe/dispatcher.py",
      "excluded_from_fixture": [
        "scripts/score_causal_probe.py",
        "examples/causal-probe-reference-dispatcher.py",
        "hidden tests",
        "prior outputs and evaluation artifacts",
        "external network access"
      ]
