      "allowed_inputs": [
        "the pristine fixture",
        "both candidate dispatcher sources",
        "scripts/score_causal_probe.py"
      ],
      "purpose": "Run public and withheld behavior contracts and reject changes outside the canonical owner."
    }
  },
